---
import BaseLayout from "../components/BaseLayout.astro";
import SpecCard from "../components/SpecCard.astro";
import ResumeEntry from "../components/ResumeEntry.astro";
import { getCollection } from "astro:content";
import { experience, leadership, awards, education, skills } from "../data/resume";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const garage = (await getCollection("garage"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="于士一 Harry Yu — I build bridges"
  description="于士一 (Harry Yu). I build bridges so no one has to be understood from a distance. Entertainment Technology @ CMU, CS @ Brandeis."
>
  <!-- the page defaults to about: 于士一 primary, Harry Yu under it.
       Only the masthead stays crisp; hovering resolves the print noise. -->
  <section id="about" class="hero" aria-labelledby="hero-name">
    <div class="lockup">
      <h1 class="zh-name" id="hero-name" lang="zh">于士一</h1>
      <p class="h-sub">Harry Yu</p>
    </div>
    <p class="statement">
      I build bridges so no one has to be understood from a distance.
    </p>
    <p class="coords mono">
      Entertainment Technology @ CMU · CS @ Brandeis '25 · Pittsburgh
    </p>

    <div class="about-block">
      <p>
        Between languages, between minds that work differently, I look for
        gaps people treat as fixed and make them crossable, and fun to cross.
      </p>
      <p class="recognition">
        Being told about someone's experience produces agreement.
        Being placed inside it produces recognition.
      </p>
      <p>
        Now at Carnegie Mellon's Entertainment Technology Center in
        Pittsburgh, the City of Bridges. Before that, CS at Brandeis and
        real-time 3D pose research at Peking University. I also build
        hardware, and keep one very stubborn 1983 Porsche 944 running.
      </p>
      <p class="mono hero-links">
        <a href="mailto:harryyu2002@gmail.com">harryyu2002@gmail.com</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/HandsomeHarry">GitHub</a>
        <span aria-hidden="true">·</span>
        <a href="/Resume_HarryYu.pdf" download>Résumé (PDF)</a>
      </p>
    </div>
  </section>

  <div class="feed">
    <section id="work" class="feed-group" aria-labelledby="work-label">
      <h2 class="label" id="work-label">01 / Projects</h2>
      <div class="postfeed">
        {projects.map((p) => <SpecCard project={p} />)}
      </div>
    </section>

    <section id="experience" class="feed-group" aria-labelledby="experience-label">
      <h2 class="label" id="experience-label">02 / Experience &amp; research</h2>
      <div class="entries">
        {experience.map((e) => <ResumeEntry entry={e} />)}
      </div>
    </section>

    <section id="leadership" class="feed-group" aria-labelledby="leadership-label">
      <h2 class="label" id="leadership-label">03 / Leadership &amp; awards</h2>
      <div class="entries">
        {leadership.map((e) => <ResumeEntry entry={e} />)}
      </div>
      <ul class="awards">
        {
          awards.map((a) => (
            <li>
              <h3>{a.href ? <a href={a.href}>{a.title}</a> : a.title}</h3>
              <p>{a.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="garage" class="feed-group" aria-labelledby="garage-label">
      <h2 class="label" id="garage-label">04 / Garage</h2>
      <div class="postfeed">
        {
          garage.map((e) => (
            <article class="spec-card garage-card">
              <p class="label">{e.data.date.toISOString().slice(0, 10)}</p>
              <h3>
                <a href={`/garage/${e.id}`}>{e.data.title}</a>
              </h3>
              <p class="summary">{e.data.summary}</p>
            </article>
          ))
        }
        <article class="spec-card garage-card">
          <p class="label">full log</p>
          <h3><a href="/garage">Every entry →</a></h3>
        </article>
      </div>
    </section>

    <section id="education" class="feed-group" aria-labelledby="education-label">
      <h2 class="label" id="education-label">05 / Education &amp; skills</h2>
      <div class="entries">
        <ResumeEntry
          entry={{
            org: education.school,
            role: education.degree,
            dates: education.dates,
            place: "Waltham, MA",
            points: education.notes,
          }}
        />
      </div>
      <dl class="skills">
        {
          skills.map(([k, v]) => (
            <div>
              <dt class="label">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>
