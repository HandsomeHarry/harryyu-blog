---
// Spec card: a project compressed to its spec lines.
// Mono metadata, one-sentence summary, stack as a parts list.
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const d = project.data;
---

<article class:list={["spec-card", { featured: d.featured }]}>
  <p class="label">
    {d.year} · {d.status}
  </p>
  <h3 class="noisy"><a href={`/work/${d.slug}`}>{d.title}</a></h3>
  <p class="summary">{d.summary}</p>
  <p class="mono parts">{d.stack.join(" · ")}</p>
</article>
