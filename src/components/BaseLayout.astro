---
import "@fontsource/tinos/400.css";
import "@fontsource/tinos/400-italic.css";
import "@fontsource/tinos/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
// Chinese name glyphs: Noto Sans SC subset to 于士一 only (3 glyphs)
// — public/fonts/name-zh.woff2, @font-face in global.css.
import "../styles/global.css";
import "../styles/components.css";
import BackgroundCar from "./BackgroundCar.astro";

interface Props {
  title: string;
  description?: string;
  prev?: string;
  next?: string;
}

const {
  title,
  description = "Shiyi Yu — I make things you can see into.",
  prev = "",
  next = "",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={false} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Theme init — before paint, no flash. Choice persists; system is default.
      (function () {
        try {
          var t = localStorage.getItem("headlights");
          if (t === "day" || t === "night") {
            document.documentElement.dataset.theme = t;
          }
        } catch (e) {
          /* private mode: ride with system preference */
        }
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body
    data-sections="work,experience,leadership,garage,education"
    data-prev={prev}
    data-next={next}
  >
    <a class="skip" href="#main">Skip to content</a>

    <!-- Print-noise filters (softlabor-style): static fractal displacement for
         no-JS .noisy type; the island below builds one filter per text block. -->
    <svg id="noise-defs" width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="noise-content" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="12" xChannelSelector="R" yChannelSelector="B" />
      </filter>
      <filter id="noise-heading" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="32" xChannelSelector="R" yChannelSelector="B" />
      </filter>
    </svg>

    <header class="masthead">
      <nav class="wrap masthead-inner" aria-label="Site">
        <div class="masthead-brand">
          <a class="wordmark" href="/">Harry Yu</a>
          <ul class="nav">
            <li><a href="/#about">About</a></li>
            <li><a href="/#work">Projects</a></li>
            <li><a href="/#experience">Experience</a></li>
            <li><a href="/#leadership">Leadership</a></li>
            <li><a href="/garage">Garage</a></li>
            <li><a href="/Resume_HarryYu.pdf" download>Résumé</a></li>
          </ul>
        </div>
      </nav>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <!-- one 944, fixed as the page backdrop -->
    <BackgroundCar />

    <!-- Hotkey HUD + help overlay -->
    <aside class="hotkey-hud" aria-label="Keyboard shortcuts">
      <kbd>1</kbd>–<kbd>5</kbd> sections · <kbd>J</kbd>/<kbd>K</kbd> projects ·
      <kbd>H</kbd> lights · <kbd>?</kbd> help
    </aside>

    <div class="help-overlay" id="help" hidden>
      <div class="help-card" role="dialog" aria-modal="true" aria-label="Keyboard shortcuts">
        <p class="label">Controls</p>
        <table>
          <tbody>
            <tr><td>1 – 5</td><td>Jump to Projects, Experience, Leadership, Garage, Education</td></tr>
            <tr><td>J / K</td><td>Next / previous project</td></tr>
            <tr><td>H</td><td>Toggle headlights (dark mode)</td></tr>
            <tr><td>?</td><td>Open / close this overlay</td></tr>
            <tr><td>Esc</td><td>Close this overlay</td></tr>
          </tbody>
        </table>
        <p class="mono" style="margin: var(--s2) 0 0; color: var(--ink-soft)">
          Hotkeys sleep while you type in a field.
        </p>
      </div>
    </div>

    <script>
      import { initHeadlights } from "../lib/headlights";
      import { initRain } from "../lib/rain";
      // ---- site island: hotkeys, help overlay, scroll reveal, konami ----
      // Vanilla, no dependencies. Everything here degrades gracefully;
      // the site is fully usable if this never runs.
      const doc = document.documentElement;

      // -- scroll reveal --
      const slabs = Array.from(document.querySelectorAll(".slab"));
      function revealVisible() {
        const vh = window.innerHeight;
        for (const s of slabs) {
          if (s.classList.contains("in")) continue;
          if (s.getBoundingClientRect().top < vh * 0.92) {
            s.classList.add("in");
          }
        }
      }
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        slabs.forEach((s) => io.observe(s));
      }
      // Fallback (and belt-and-suspenders): reveal on scroll position.
      // Covers environments where IO callbacks never fire, plus scroll restoration.
      addEventListener("scroll", revealVisible, { passive: true });
      revealVisible();

      // -- layout: publish the masthead rule height for the background car --
      const masthead = document.querySelector(".masthead");
      function syncHeadHeight() {
        if (masthead) {
          document.documentElement.style.setProperty(
            "--head-h",
            `${(masthead as HTMLElement).offsetHeight}px`
          );
        }
      }
      syncHeadHeight();
      addEventListener("resize", syncHeadHeight, { passive: true });

      // -- print noise (softlabor.biz reference) --
      // softlabor warps type with feTurbulence -> feDisplacementMap. A card
      // resolves as a whole only while it is hovered. Measured in Chrome via
      // REA: displacement falls ~15 -> 1.3 in 600ms (a fast-start curve,
      // tau ~250ms) and recovers in ~300ms on leave. On article pages,
      // paragraphs also resolve 500ms after they scroll into view.
      // Each text block in <main> gets its own filter; the masthead stays
      // crisp;
      // small screens, reduced motion and no-JS visitors get crisp type.
      const reducedMotion = matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      const smallScreen = matchMedia("(max-width: 760px)").matches;
      const defsHost = document.getElementById("noise-defs");

      if (!reducedMotion && !smallScreen && defsHost) {
        const SVGNS = "http://www.w3.org/2000/svg";
        const SHARPEN_TAU = 250; // ~90% resolved after 600ms
        const DENOISE_TAU = 100; // ~95% re-noised after 300ms
        const READ_DELAY = 500; // article text resolves this long after entering view
        const DRIFT = 0.05; // base-frequency drift over 300s
        const TEXT = "h1, h2, h3, h4, p, li, dt, dd, th, td, figcaption, blockquote, pre";
        const ARTICLE = ".project-body, .project-summary";
        // hovering anywhere in one of these resolves all of its text at once
        const CARD = ".spec-card, .entry, .awards li, .skills > div, .hero .lockup";

        type NoiseRec = {
          el: HTMLElement;
          disp: SVGElement;
          base: number;
          cur: number;
          hovered: boolean;
          focused: boolean;
          read: boolean;
          timer: number;
          filter: SVGFilterElement;
        };
        const recs: NoiseRec[] = [];
        const byEl = new Map<Element, NoiseRec>();
        const drifts: { turb: SVGElement; base: number }[] = [];
        const born = performance.now();
        let uid = 0;
        const usedSeeds = new Set<number>();
        function nextSeed(): number {
          let s = 1 + Math.floor(Math.random() * 999);
          while (usedSeeds.has(s)) s = 1 + ((s + 1) % 999);
          usedSeeds.add(s);
          return s;
        }

        // The filter region is a percentage of the element's box. At 0%/100%
        // displaced pixels are cut off at the box edge, which squares off
        // tightly boxed type like the hero name. Pad it by the farthest a
        // pixel can move (half the displacement scale) on every side.
        function fitRegion(rec: NoiseRec) {
          const { width, height } = rec.el.getBoundingClientRect();
          if (!width || !height) return;
          const pad = rec.base / 2 + 2;
          const px = (pad / width) * 100, py = (pad / height) * 100;
          rec.filter.setAttribute("x", `${-px}%`);
          rec.filter.setAttribute("y", `${-py}%`);
          rec.filter.setAttribute("width", `${100 + 2 * px}%`);
          rec.filter.setAttribute("height", `${100 + 2 * py}%`);
        }

        let raf = 0;
        let last = 0;
        function frame(now: number) {
          const dt = Math.min(64, now - last);
          last = now;
          let settling = false;
          for (const rec of recs) {
            const target = rec.hovered || rec.focused || rec.read ? 0 : rec.base;
            if (rec.cur === target) continue;
            const tau = target < rec.cur ? SHARPEN_TAU : DENOISE_TAU;
            let next = rec.cur + (target - rec.cur) * (1 - Math.exp(-dt / tau));
            if (Math.abs(target - next) < 0.05) next = target;
            else settling = true;
            rec.cur = next;
            rec.disp.setAttribute("scale", next.toFixed(2));
          }
          raf = settling ? requestAnimationFrame(frame) : 0;
        }
        function wake() {
          if (raf) return;
          last = performance.now();
          raf = requestAnimationFrame(frame);
        }

        function wireNoise() {
          // every text block in <main>; the outermost match carries the
          // filter so nested blocks are not warped twice
          const chosen = new Set<Element>();
          const reader = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              const rec = byEl.get(entry.target)!;
              clearTimeout(rec.timer);
              if (entry.isIntersecting) {
                rec.timer = window.setTimeout(() => {
                  rec.read = true;
                  wake();
                }, READ_DELAY);
              } else {
                rec.read = false;
                wake();
              }
            }
          });
          for (const el of document.querySelectorAll<HTMLElement>(
            TEXT.split(", ").map((t) => `main ${t}`).join(", ")
          )) {
            if (!el.textContent?.trim()) continue;
            let up = el.parentElement;
            while (up && !chosen.has(up)) up = up.parentElement;
            if (up) continue;
            chosen.add(el);

            const fs = parseFloat(getComputedStyle(el).fontSize);
            if (!fs) continue;
            // Text under 48px matches softlabor's clarity: 15px on their 24px
            // body, never more than 15px, so card titles read like theirs.
            // Display type (hero name, page titles) keeps the heavier 0.9x.
            const scale = fs >= 48
              ? Math.round(fs * 0.9)
              : Math.max(4, Math.min(15, Math.round(fs * 15 / 24)));
            const base = 0.88 + Math.random() * 0.04; // per-element jitter

            const filter = document.createElementNS(SVGNS, "filter");
            filter.id = `noise-el-${uid++}`;
            const turb = document.createElementNS(SVGNS, "feTurbulence");
            turb.setAttribute("type", "fractalNoise");
            turb.setAttribute("baseFrequency", String(base));
            turb.setAttribute("numOctaves", "1");
            turb.setAttribute("seed", String(nextSeed()));
            turb.setAttribute("result", "noise");
            const disp = document.createElementNS(SVGNS, "feDisplacementMap");
            disp.setAttribute("in", "SourceGraphic");
            disp.setAttribute("in2", "noise");
            disp.setAttribute("scale", String(scale));
            disp.setAttribute("xChannelSelector", "R");
            disp.setAttribute("yChannelSelector", "B");
            filter.append(turb, disp);
            defsHost!.append(filter);
            drifts.push({ turb, base });
            el.style.filter = `url(#${filter.id})`;

            const rec: NoiseRec = {
              el, disp, base: scale, cur: scale,
              hovered: false, focused: false, read: false, timer: 0, filter,
            };
            fitRegion(rec);
            recs.push(rec);
            byEl.set(el, rec);
            const hoverRoot = el.closest<HTMLElement>(CARD) ?? el;
            hoverRoot.addEventListener("mouseenter", () => { rec.hovered = true; wake(); });
            hoverRoot.addEventListener("mouseleave", () => { rec.hovered = false; wake(); });
            if (el.closest(ARTICLE)) reader.observe(el);
          }

          const syncFocus = () => {
            const active = document.activeElement;
            for (const rec of recs) rec.focused = !!active && rec.el.contains(active);
            wake();
          };
          addEventListener("resize", () => recs.forEach(fitRegion), { passive: true });
          document.addEventListener("focusin", syncFocus);
          document.addEventListener("focusout", () => setTimeout(syncFocus));

          // slow drift: baseFrequency 0.9 -> 0.95 over 300s, never loops
          window.setInterval(() => {
            const f = Math.min(1, (performance.now() - born) / 300000);
            for (const d of drifts) {
              d.turb.setAttribute("baseFrequency", (d.base + DRIFT * f).toFixed(4));
            }
          }, 4000);
        }

        if (document.fonts?.ready) {
          document.fonts.ready.then(() => wireNoise());
        } else {
          wireNoise();
        }
      }

      // Rigid headlight meshes, illumination, theme persistence and motion.
      const { currentTheme, setTheme } = initHeadlights();
      const rainCanvas = document.querySelector<HTMLCanvasElement>(".glass-layer");
      const rain = rainCanvas ? initRain(rainCanvas, rainCanvas.hasAttribute("data-on")) : null;

      // -- help overlay --
      const help = document.getElementById("help")!;
      function toggleHelp(force?: boolean) {
        const show = force ?? help.hidden;
        help.hidden = !show;
        if (show) (help.querySelector("td") as HTMLElement)?.focus?.();
      }
      help.addEventListener("click", (e) => {
        if (e.target === help) toggleHelp(false);
      });

      // -- hotkeys --
      const body = document.body;
      const sectionIds = (body.dataset.sections || "").split(",").filter(Boolean);
      document.addEventListener("keydown", (e) => {
        const target = e.target as HTMLElement;
        const typing =
          target.closest("input, textarea, select, [contenteditable]") !== null;
        if (typing || e.metaKey || e.ctrlKey || e.altKey) return;

        if (e.key === "Escape") {
          if (!help.hidden) toggleHelp(false);
          return;
        }
        if (e.key === "?" || (e.key === "/" && e.shiftKey)) {
          e.preventDefault();
          toggleHelp();
          return;
        }
        if (e.key === "h" || e.key === "H") {
          setTheme(currentTheme() === "night" ? "day" : "night");
          return;
        }
        if (e.key === "r" || e.key === "R") {
          rain?.toggle();
          return;
        }
        if (/^[1-5]$/.test(e.key)) {
          const id = sectionIds[Number(e.key) - 1];
          const el = id && document.getElementById(id);
          if (el) {
            e.preventDefault();
            el.scrollIntoView({ behavior: "smooth" });
          }
          return;
        }
        if (e.key === "j" || e.key === "J") {
          const href = body.dataset.next;
          if (href) location.href = href;
          return;
        }
        if (e.key === "k" || e.key === "K") {
          const href = body.dataset.prev;
          if (href) location.href = href;
          return;
        }
      });

      // -- konami: flash headlights twice, reveal /pit --
      const konami = [
        "ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown",
        "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight",
        "b", "a",
      ];
      let ki = 0;
      document.addEventListener("keydown", (e) => {
        const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
        ki = key === konami[ki] ? ki + 1 : key === konami[0] ? 1 : 0;
        if (ki !== konami.length) return;
        ki = 0;
        const pair = document.getElementById("lights");
        if (pair) {
          pair.classList.remove("flash");
          void pair.offsetWidth; // restart animation
          pair.classList.add("flash");
        }
        const pit = document.createElement("a");
        pit.href = "/pit";
        pit.textContent = "/pit";
        pit.className = "mono";
        pit.style.cssText =
          "position:fixed;right:16px;bottom:16px;z-index:99;color:var(--cherokee)";
        document.body.appendChild(pit);
      });
    </script>
  </body>
</html>
